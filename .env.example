# Jimoty CLI Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Default target prefecture (e.g., tokyo, osaka, kanagawa)
JIMOTY_PREFECTURE=tokyo

# Default municipality or area (e.g., shinjuku, shibuya)
JIMOTY_MUNICIPALITY=

# Default listing category (e.g., sale, free, community)
JIMOTY_CATEGORY=sale

# Maximum price filter in JPY (optional)
# JIMOTY_MAX_PRICE=10000

# HTTP request timeout in seconds (default: 30)
JIMOTY_TIMEOUT=30
